---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Services from "@/components/sections/Services.astro";
import Projects from "@/components/sections/Projects.astro";
import Process from "@/components/sections/Process.astro";
import Contact from "@/components/sections/Contact.astro";
---

<Layout>
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-dark focus:outline-none"
    >
        Saltar al contenido principal
    </a>

    <Header />

    <main id="main-content">
        <Hero />
        <About />
        <Services />
        <Projects />
        <Process />
        <Contact />
    </main>

    <Footer />
</Layout>
