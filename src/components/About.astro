---
import TeamCardBody from "./TeamCardBody.astro";

const values = [
  { label: "01", title: "Diseño con intención", description: "Cada decisión visual tiene un propósito. No decoramos, comunicamos." },
  { label: "02", title: "Código con precisión", description: "Construimos interfaces limpias, accesibles y pensadas para durar." },
  { label: "03", title: "Colaboración real", description: "Trabajamos codo a codo con nuestros clientes, no para ellos." },
];

const team = [
  {
    name: "Carmen",
    role: "Diseño & Dirección creativa",
    bio: "Transforma ideas en interfaces que las personas quieren usar. Especializada en UX, sistemas de diseño e identidad digital.",
  },
  {
    name: "Diego",
    role: "Desarrollo & Arquitectura web",
    bio: "Convierte diseños en experiencias web rápidas, accesibles y escalables. Apasionado por el código limpio y las tecnologías modernas.",
  },
];
---

<section id="nosotros" class="section-padding relative overflow-hidden" aria-labelledby="nosotros-heading">
  <div class="max-w-[1600px] mx-auto relative z-10">
    <p class="eyebrow mb-8 reveal">( Nosotros )</p>

    <h2 id="nosotros-heading" class="display-sm reveal-lines">
      <span style="--d:0">Dos mentes,</span>
      <span style="--d:1">un <span class="text-primary italic font-serif lowercase">estudio</span></span>
    </h2>

    <p class="font-mono text-gray-400 mt-10 max-w-2xl text-lg reveal" style="--d:1">
      Somos Carmen y Diego — diseñadora y desarrollador. Unimos criterio estético y
      precisión técnica para crear productos digitales que funcionan y enamoran.
    </p>

    <div class="grid md:grid-cols-2 gap-px bg-white/10 mt-20 border border-white/10">
      {team.map((member, i) => (
        <div
          class="team-card relative isolate overflow-hidden bg-dark p-10 md:p-14 reveal"
          style={`--d:${i}`}
          data-cursor
          data-cursor-label={member.name}
        >
          <div class="relative z-10">
            <TeamCardBody index={i} role={member.role} name={member.name} bio={member.bio} />
          </div>
          <div class="team-card__hover absolute inset-0 z-20 bg-primary p-10 md:p-14" aria-hidden="true">
            <TeamCardBody index={i} role={member.role} name={member.name} bio={member.bio} variant="hover" />
          </div>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-3 gap-10 md:gap-8 pt-16 mt-16 border-t border-white/10">
      {values.map((value, i) => (
        <div class="reveal" style={`--d:${i}`}>
          <span class="font-mono text-xs text-primary mb-4 block">{value.label}</span>
          <h3 class="text-2xl font-extrabold mb-3">{value.title}</h3>
          <p class="font-mono text-sm text-gray-400 leading-relaxed">{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Lime layer holds a black copy of the content and is revealed with a
     hard clip edge, so the text flips exactly with the wipe — no colour fade. */
  .team-card__hover {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: clip-path;
  }

  /* CSS-only fallback (no JS / keyboard focus) */
  .team-card:hover .team-card__hover,
  .team-card:focus-within .team-card__hover {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card__hover {
      clip-path: inset(0 0 0 0);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .team-card:hover .team-card__hover {
      opacity: 1;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    const hidden: Record<string, string> = {
      top: 'inset(0 0 100% 0)',
      bottom: 'inset(100% 0 0 0)',
      left: 'inset(0 100% 0 0)',
      right: 'inset(0 0 0 100%)',
    };
    const shown = 'inset(0 0 0 0)';

    document.querySelectorAll<HTMLElement>('.team-card').forEach((card) => {
      const layer = card.querySelector<HTMLElement>('.team-card__hover');
      if (!layer) return;

      const edge = (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        return Math.abs(x) > Math.abs(y)
          ? (x > 0 ? 'right' : 'left')
          : (y > 0 ? 'bottom' : 'top');
      };

      card.addEventListener('pointerenter', (e) => {
        layer.style.transition = 'none';
        layer.style.clipPath = hidden[edge(e)];
        void layer.offsetWidth; // flush the start position
        layer.style.transition = '';
        layer.style.clipPath = shown;
      });

      card.addEventListener('pointerleave', (e) => {
        layer.style.clipPath = hidden[edge(e)];
      });
    });
  }
</script>
