---
const steps = [
  { number: "01", title: "Descubrimiento", description: "Analizamos tus objetivos, audiencia y competencia para definir la estrategia perfecta." },
  { number: "02", title: "Diseño", description: "Creamos wireframes y diseños visuales que dan vida a tu visión de manera única." },
  { number: "03", title: "Desarrollo", description: "Transformamos los diseños en código limpio, eficiente y escalable." },
  { number: "04", title: "Lanzamiento", description: "Desplegamos tu proyecto y te acompañamos en su evolución continua." },
];
---

<section id="proceso" class="section-padding bg-primary text-dark relative overflow-hidden">
  <div class="max-w-[1600px] mx-auto">
    <div class="mb-20">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-dark/60 mb-8 reveal">( Proceso )</p>
      <h2 class="display reveal-lines">
        <span style="--d:0">Cómo</span>
        <span style="--d:1" class="italic font-serif lowercase">trabajamos</span>
      </h2>
      <p class="font-mono text-dark/70 max-w-xl mt-10 reveal" style="--d:1">
        Un proceso colaborativo y transparente diseñado para entregar resultados excepcionales.
      </p>
    </div>

    <div class="border-t border-dark/20">
      {steps.map((step, i) => (
        <div
          class="group grid md:grid-cols-12 gap-6 items-baseline py-10 md:py-12 border-b border-dark/20 reveal"
          style={`--d:${i}`}
        >
          <span class="md:col-span-2 font-mono text-lg">{step.number}</span>
          <h3 class="md:col-span-4 display-sm !text-[clamp(1.8rem,4vw,3.25rem)] transition-transform duration-500 group-hover:translate-x-3">
            {step.title}
          </h3>
          <p class="md:col-span-6 font-mono text-sm md:text-base leading-relaxed text-dark/70 md:text-right md:ml-auto max-w-md">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
