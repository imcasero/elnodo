---
---

<section id="contacto" class="section-padding relative overflow-hidden border-t border-white/10" aria-labelledby="contacto-heading">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute bottom-0 left-1/4 w-[40vw] h-[40vw] bg-primary/10 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-[1600px] mx-auto relative z-10">
    <p class="eyebrow mb-8 reveal">( Contacto )</p>
    <h2 id="contacto-heading" class="display reveal-lines mb-16">
      <span style="--d:0">Hagamos algo</span>
      <span style="--d:1" class="text-primary text-glow italic font-serif lowercase">increíble</span>
      <span style="--d:2">juntos<span class="text-primary">.</span></span>
    </h2>

    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div class="reveal" style="--d:1">
        <p class="font-mono text-gray-400 mb-12 text-lg max-w-md">
          Cuéntanos sobre tu proyecto y te responderemos en menos de 24 horas.
        </p>

        <div class="border-t border-white/10">
          <a href="mailto:hola@elnodo.studio" class="group flex items-center justify-between py-6 border-b border-white/10" data-cursor-label="Email">
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-gray-500">Email</span>
            <span class="text-lg md:text-2xl font-extrabold group-hover:text-primary transition-colors">hola@elnodo.studio</span>
          </a>
          <a href="https://elnodo.studio" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between py-6 border-b border-white/10" data-cursor-label="Web">
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-gray-500">Web</span>
            <span class="text-lg md:text-2xl font-extrabold group-hover:text-primary transition-colors">elnodo.studio</span>
          </a>
        </div>
      </div>

      <div class="reveal" style="--d:2">
        <form class="space-y-8" aria-label="Formulario de contacto" novalidate>
          <div class="grid sm:grid-cols-2 gap-8">
            <div>
              <label for="name" class="font-mono text-xs uppercase tracking-[0.12em] text-gray-400 mb-3 flex items-center gap-1">
                Nombre <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input type="text" id="name" name="name" required aria-required="true"
                class="w-full bg-transparent border-b border-white/20 py-3 text-light placeholder-gray-600 focus:outline-none focus:border-primary transition-colors"
                placeholder="Tu nombre" />
            </div>
            <div>
              <label for="email" class="font-mono text-xs uppercase tracking-[0.12em] text-gray-400 mb-3 flex items-center gap-1">
                Email <span class="text-primary" aria-hidden="true">*</span>
              </label>
              <input type="email" id="email" name="email" required aria-required="true"
                class="w-full bg-transparent border-b border-white/20 py-3 text-light placeholder-gray-600 focus:outline-none focus:border-primary transition-colors"
                placeholder="tu@email.com" />
            </div>
          </div>

          <div>
            <label for="service" class="font-mono text-xs uppercase tracking-[0.12em] text-gray-400 mb-3 block">Servicio</label>
            <div class="relative">
              <select id="service" name="service"
                class="w-full bg-transparent border-b border-white/20 py-3 text-light focus:outline-none focus:border-primary transition-colors appearance-none cursor-pointer pr-10">
                <option class="bg-dark" value="">Selecciona un servicio</option>
                <option class="bg-dark" value="web-design">Diseño Web</option>
                <option class="bg-dark" value="web-dev">Desarrollo Web</option>
                <option class="bg-dark" value="branding">Branding Digital</option>
                <option class="bg-dark" value="consulting">Consultoría</option>
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>

          <div>
            <label for="message" class="font-mono text-xs uppercase tracking-[0.12em] text-gray-400 mb-3 flex items-center gap-1">
              Mensaje <span class="text-primary" aria-hidden="true">*</span>
            </label>
            <textarea id="message" name="message" rows="4" required aria-required="true"
              class="w-full bg-transparent border-b border-white/20 py-3 text-light placeholder-gray-600 focus:outline-none focus:border-primary transition-colors resize-none"
              placeholder="Cuéntanos sobre tu proyecto..."></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto" data-magnetic="0.25" data-cursor-label="Enviar">
            Enviar mensaje
          </button>

          <p class="font-mono text-xs text-gray-500">
            <span class="text-primary" aria-hidden="true">*</span> Campos obligatorios
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
