---
const services = [
  {
    number: "01",
    title: "Diseño Web",
    description: "Creamos interfaces intuitivas y visualmente impactantes que capturan la esencia de tu marca y conectan con tu audiencia.",
    features: ["UI/UX Design", "Prototipos interactivos", "Design Systems"],
  },
  {
    number: "02",
    title: "Desarrollo Web",
    description: "Construimos sitios web y aplicaciones de alto rendimiento utilizando las tecnologías más modernas del mercado.",
    features: ["React / Next.js", "Astro / Vite", "Headless CMS"],
  },
  {
    number: "03",
    title: "Branding Digital",
    description: "Desarrollamos identidades visuales coherentes que destacan en el ecosistema digital y generan reconocimiento.",
    features: ["Identidad visual", "Motion design", "Guidelines"],
  },
  {
    number: "04",
    title: "Consultoría",
    description: "Asesoramos a empresas en su transformación digital, optimizando procesos y maximizando resultados.",
    features: ["Estrategia digital", "Auditorías UX", "Optimización"],
  },
];
---

<section id="servicios" class="section-padding bg-dark relative border-t border-white/10">
  <div class="max-w-[1600px] mx-auto">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-20">
      <div>
        <p class="eyebrow mb-8 reveal">( Servicios )</p>
        <h2 class="display reveal-lines">
          <span style="--d:0">Lo que</span>
          <span style="--d:1" class="text-primary italic font-serif lowercase">hacemos</span>
        </h2>
      </div>
      <p class="font-mono text-gray-400 max-w-sm text-sm reveal" style="--d:1">
        Combinamos diseño estratégico con desarrollo técnico para crear productos
        digitales que impulsan tu negocio.
      </p>
    </div>

    <div class="border-t border-white/10">
      {services.map((service, i) => (
        <article
          class="group grid md:grid-cols-12 gap-6 md:gap-8 items-start py-10 md:py-14 border-b border-white/10 transition-colors duration-500 hover:bg-white/[0.03] reveal"
          style={`--d:${i}`}
          data-cursor-label="Servicio"
        >
          <span class="md:col-span-1 font-mono text-sm text-primary">{service.number}</span>
          <h3 class="md:col-span-4 display-sm !text-[clamp(1.8rem,4vw,3rem)] transition-transform duration-500 group-hover:translate-x-3">
            {service.title}
          </h3>
          <p class="md:col-span-4 text-gray-400 leading-relaxed">{service.description}</p>
          <div class="md:col-span-3 flex flex-wrap gap-2 md:justify-end">
            {service.features.map((feature) => (
              <span class="font-mono text-[11px] uppercase tracking-wide px-3 py-1.5 rounded-full border border-white/15 text-gray-400 group-hover:border-primary/40 group-hover:text-primary transition-colors duration-300">
                {feature}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
