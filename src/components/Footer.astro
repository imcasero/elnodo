  { name: "Dribbble", href: "#", icon: "M12 0c-6.628 0-12 5.373-12 12s5.372 12 12 12 12-5.373 12-12-5.372-12-12-12zm9.885 11.441c-2.575-.422-4.943-.445-7.103-.073-.244-.563-.497-1.125-.767-1.68 2.31-1 4.165-2.358 5.548-4.082 1.35 1.594 2.197 3.619 2.322 5.835zm-3.842-7.282c-1.205 1.554-2.868 2.783-4.986 3.68-1.016-1.861-2.178-3.676-3.488-5.438.779-.197 1.591-.314 2.431-.314 2.275 0 4.368.779 6.043 2.072zm-10.516-.993c1.331 1.742 2.511 3.538 3.537 5.381-2.43.715-5.331 1.082-8.684 1.105.692-2.835 2.601-5.193 5.147-6.486zm-5.44 8.834l.013-.256c3.849-.005 7.169-.448 9.95-1.322.233.475.456.952.67 1.432-3.38 1.057-6.165 3.222-8.337 6.48-1.432-1.719-2.296-3.927-2.296-6.334zm3.829 7.81c1.969-3.088 4.482-5.098 7.598-6.027.928 2.42 1.609 4.91 2.043 7.46-3.349 1.291-6.953.666-9.641-1.433zm11.586.43c-.438-2.353-1.08-4.653-1.92-6.897 1.876-.265 3.94-.196 6.199.196-.437 2.786-2.028 5.192-4.279 6.701z" },
];

const nav = [
  { href: "#nosotros", label: "Nosotros" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#proceso", label: "Proceso" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="border-t border-white/10 overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12 lg:px-20 pt-24 pb-10">
    <!-- Top: CTA + meta -->
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 pb-20">
      <div class="lg:col-span-6">
        <p class="eyebrow mb-6">( Estudio de diseño & desarrollo )</p>
        <p class="display-sm !text-[clamp(1.6rem,3.5vw,2.75rem)] !leading-[1.1] max-w-xl">
          ¿Tienes una idea?
          <a href="#contacto" class="text-primary italic font-serif lowercase link-underline" data-cursor-label="Hablemos">Hablemos</a>.
        </p>
      </div>

      <nav class="lg:col-span-3 lg:col-start-8" aria-label="Enlaces del pie de página">
        <p class="eyebrow mb-6">Enlaces</p>
        <ul class="space-y-3">
          {nav.map((link) => (
            <li>
              <a href={link.href} class="font-mono text-sm text-gray-400 hover:text-light link-underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <p class="eyebrow mb-6">Contacto</p>
        <ul class="space-y-3">
          <li>
            <a href="mailto:hola@elnodo.studio" class="font-mono text-sm text-gray-400 hover:text-light link-underline break-all">
              hola@elnodo.studio
            </a>
          </li>
          <li>
            <a href="https://elnodo.studio" target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-gray-400 hover:text-light link-underline">
              elnodo.studio
            </a>
          </li>
        </ul>

        <div class="flex gap-3 mt-8">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.name}
              class="w-10 h-10 rounded-full border border-white/15 hover:border-primary hover:bg-primary flex items-center justify-center transition-colors duration-300 group"
            >
              <svg class="w-4 h-4 text-gray-400 group-hover:text-dark transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Giant wordmark -->
    <a href="#contacto" class="block group" aria-label="Ir a contacto" data-cursor-label="Hablemos">
      <span class="block leading-[0.78] py-6 border-t border-white/10 font-extrabold uppercase tracking-[-0.04em] text-[clamp(3.5rem,17vw,15rem)] transition-colors duration-500">
        el<span class="text-primary group-hover:text-light transition-colors duration-500">nodo</span>
      </span>
    </a>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <p class="font-mono text-xs text-gray-500">
        &copy; {currentYear} elnodo — Todos los derechos reservados.
      </p>
      <p class="font-mono text-xs text-gray-500">
        Diseñado y desarrollado con <span class="text-primary">pasión</span>
      </p>
    </div>
  </div>
</footer>
