---
import type { TeamMember } from "@/types";

interface Props {
  member: TeamMember;
  index: number;
  /** `hover` renders the dark-on-lime copy shown by the wipe. */
  variant?: "base" | "hover";
}

const { member, index, variant = "base" } = Astro.props;
const isHover = variant === "hover";
---

<span
  class:list={[
    "font-mono text-xs uppercase tracking-[0.2em]",
    isHover ? "text-dark" : "text-primary",
  ]}
>
  {String(index + 1).padStart(2, "0")} / {member.role}
</span>
<h3 class:list={["display-sm mb-6 mt-6", isHover ? "text-dark" : "text-light"]}>
  {member.name}
</h3>
<p
  class:list={[
    "max-w-sm font-mono text-sm leading-relaxed",
    isHover ? "text-dark/70" : "text-gray-400",
  ]}
>
  {member.bio}
</p>
