---
import type { ProcessStep } from "@/types";

interface Props {
  step: ProcessStep;
  index: number;
}

const { step, index } = Astro.props;
---

<div
  class="group reveal grid items-baseline gap-6 border-b border-dark/20 py-10 md:grid-cols-12 md:py-12"
  style={`--d:${index}`}
>
  <span class="font-mono text-lg md:col-span-2">{step.number}</span>
  <h3
    class="display-xs transition-transform duration-500 group-hover:translate-x-3 md:col-span-4"
  >
    {step.title}
  </h3>
  <p
    class="max-w-md font-mono text-sm leading-relaxed text-dark/70 md:col-span-6 md:ml-auto md:text-right md:text-base"
  >
    {step.description}
  </p>
</div>
