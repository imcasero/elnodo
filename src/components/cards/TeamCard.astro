---
import type { TeamMember } from "@/types";
import TeamCardBody from "@/components/cards/TeamCardBody.astro";

interface Props {
    member: TeamMember;
    index: number;
}

const { member, index } = Astro.props;
---

<div
    class="team-card reveal relative isolate overflow-hidden bg-dark p-10 md:p-14"
    style={`--d:${index}`}
    data-cursor
    data-cursor-label={member.name}
>
    <div class="relative z-10">
        <TeamCardBody member={member} index={index} />
    </div>
    <div class="team-card__hover absolute inset-0 z-20 bg-primary p-10 md:p-14" aria-hidden="true">
        <TeamCardBody member={member} index={index} variant="hover" />
    </div>
</div>

<style>
    /* The lime layer carries a dark copy of the content and is revealed with a
     hard clip edge, so text flips exactly with the wipe — no colour fade.
     Direction is set at runtime by `@/lib/motion/team-card-wipe`. */
    .team-card__hover {
        clip-path: inset(100% 0 0 0);
        transition: clip-path 0.6s var(--ease-fluid);
        will-change: clip-path;
        pointer-events: none;
    }

    .team-card:hover .team-card__hover {
        clip-path: inset(0 0 0 0);
    }

    @media (prefers-reduced-motion: reduce) {
        .team-card__hover {
            clip-path: inset(0 0 0 0);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .team-card:hover .team-card__hover {
            opacity: 1;
        }
    }
</style>
