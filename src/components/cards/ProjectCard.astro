---
import type { Project } from "@/types";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const flipped = index % 2 === 1;
const number = String(index + 1).padStart(2, "0");
---

<article
  class="group reveal grid items-center gap-8 md:grid-cols-2 md:gap-16"
  data-cursor-label="Ver caso"
>
  <div class:list={["relative overflow-hidden", flipped && "md:order-2"]}>
    <div class="aspect-[4/3] overflow-hidden bg-gray-900">
      <img
        src={project.image}
        alt={project.title}
        width="1200"
        height="800"
        loading="lazy"
        class="size-full scale-105 object-cover grayscale transition-all duration-700 ease-fluid group-hover:scale-100 group-hover:grayscale-0"
      />
    </div>
    <span class="absolute left-4 top-4 bg-primary px-3 py-1 font-mono text-xs text-dark">
      {number}
    </span>
  </div>

  <div class:list={[flipped && "md:order-1"]}>
    <span class="mb-4 block font-mono text-xs uppercase tracking-[0.15em] text-primary">
      {project.category}
    </span>
    <h3 class="display-md mb-6 transition-colors duration-300 group-hover:text-primary">
      {project.title}
    </h3>
    <p class="mb-8 max-w-md leading-relaxed text-gray-400">{project.description}</p>
    <ul class="mb-8 flex flex-wrap gap-2">
      {
        project.tags.map((tag) => (
          <li class="rounded-full border border-white/15 px-3 py-1 font-mono text-[11px] uppercase tracking-wide text-gray-400">
            {tag}
          </li>
        ))
      }
    </ul>
    <a
      href={project.href}
      class="link-underline inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-light"
    >
      Ver proyecto
      <Icon name="arrow-right" />
    </a>
  </div>
</article>
