---
interface Props {
  index: number;
  role: string;
  name: string;
  bio: string;
  variant?: "base" | "hover";
}

const { index, role, name, bio, variant = "base" } = Astro.props;
const isHover = variant === "hover";
---

<span
  class:list={[
    "font-mono text-xs uppercase tracking-[0.2em]",
    isHover ? "text-dark" : "text-primary",
  ]}
>
  0{index + 1} / {role}
</span>
<h3 class:list={["display-sm mt-6 mb-6", isHover ? "text-dark" : "text-light"]}>
  {name}
</h3>
<p
  class:list={[
    "font-mono text-sm leading-relaxed max-w-sm",
    isHover ? "text-dark/70" : "text-gray-400",
  ]}
>
  {bio}
</p>
