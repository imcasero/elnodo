---
export type IconName = "arrow-right" | "chevron-down" | "menu" | "close";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
  "arrow-right": "M17 8l4 4m0 0l-4 4m4-4H3",
  "chevron-down": "M19 9l-7 7-7-7",
  menu: "M4 7h16M4 17h16",
  close: "M6 18L18 6M6 6l12 12",
};
---

<svg
  class:list={["size-4", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={PATHS[name]} />
</svg>
