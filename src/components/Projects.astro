---
const projects = [
  {
    title: "Fintech Dashboard",
    category: "Diseño UI/UX + Desarrollo",
    description: "Plataforma de gestión financiera con visualización de datos en tiempo real.",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&h=800&fit=crop",
    tags: ["React", "TypeScript", "D3.js"],
  },
  {
    title: "E-commerce Premium",
    category: "Diseño + Desarrollo Web",
    description: "Tienda online de alta gama con experiencia de compra personalizada.",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&h=800&fit=crop",
    tags: ["Next.js", "Shopify", "Tailwind"],
  },
  {
    title: "App de Bienestar",
    category: "Branding + UI/UX",
    description: "Aplicación móvil para seguimiento de hábitos saludables.",
    image: "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?w=1200&h=800&fit=crop",
    tags: ["Figma", "React Native", "Motion"],
  },
];
---

<section id="proyectos" class="section-padding relative overflow-hidden border-t border-white/10">
  <div class="max-w-[1600px] mx-auto relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-20">
      <div>
        <p class="eyebrow mb-8 reveal">( Proyectos )</p>
        <h2 class="display reveal-lines">
          <span style="--d:0">Trabajo</span>
          <span style="--d:1" class="text-primary italic font-serif lowercase">seleccionado</span>
        </h2>
      </div>
      <a href="#" class="font-mono text-xs uppercase tracking-[0.15em] text-gray-400 hover:text-light link-underline flex items-center gap-2 reveal" style="--d:1">
        Ver todos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>

    <div class="space-y-24 md:space-y-40">
      {projects.map((project, index) => (
        <article
          class="group grid md:grid-cols-2 gap-8 md:gap-16 items-center reveal"
          data-cursor-label="Ver caso"
        >
          <div class={`relative overflow-hidden ${index % 2 === 1 ? 'md:order-2' : ''}`}>
            <div class="aspect-[4/3] overflow-hidden bg-gray-900">
              <img
                src={project.image}
                alt={project.title}
                width="1200"
                height="800"
                class="w-full h-full object-cover scale-105 grayscale transition-all duration-[900ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-100 group-hover:grayscale-0"
                loading="lazy"
              />
            </div>
            <span class="absolute top-4 left-4 font-mono text-xs bg-primary text-dark px-3 py-1">
              0{index + 1}
            </span>
          </div>

          <div class={`${index % 2 === 1 ? 'md:order-1' : ''}`}>
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-primary mb-4 block">{project.category}</span>
            <h3 class="display-sm !text-[clamp(2rem,5vw,4rem)] mb-6 transition-colors duration-300 group-hover:text-primary">
              {project.title}
            </h3>
            <p class="text-gray-400 mb-8 leading-relaxed max-w-md">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-8">
              {project.tags.map((tag) => (
                <span class="font-mono text-[11px] uppercase tracking-wide px-3 py-1 rounded-full border border-white/15 text-gray-400">{tag}</span>
              ))}
            </div>
            <a href="#" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-light link-underline">
              Ver proyecto
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
